models/checkpoints_vessel/
web/tests/golden/
.venv/
__pycache__/
models/checkpoints_lesion_v2/
data/cache/patches/neg_train/
data/cache/patches/neg_val/
models/trainedNet_v3.mat
web/.gradio/
